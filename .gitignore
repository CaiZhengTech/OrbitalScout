# Data. The modelling dataset is single-digit GB and is rebuilt by the pipeline.
data/
*.parquet
*.duckdb
*.duckdb.wal
*.tif
*.tiff
*.nc
*.zarr/

# Secrets. Never commit credentials or Earth Engine service-account keys.
.env
*.pem
*.json.key
service-account*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Test fixtures are real data, deliberately committed. They are a crop of the
# Earth Engine export, about 20 KB, and carry the file shapes that synthetic
# fixtures do not reproduce.
!tests/fixtures/
!tests/fixtures/*.tif

# OS
.DS_Store
Thumbs.db
